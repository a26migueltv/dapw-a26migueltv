Vagrant.configure("2") do |config|
    config.vm.box = "debian/bookworm64"
  
    maquinas = [
      { vb_name: "prod-mtv", hostname: "prod-mtv", ip: "192.168.56.141" }
    ]
  
    maquinas.each do |m|
      config.vm.define m[:hostname] do |node|
        node.vm.hostname = m[:hostname]
  
        # Host-only network
        node.vm.network "private_network", ip: m[:ip]
  
        node.vm.provider "virtualbox" do |vb|
          vb.name = m[:vb_name]
          vb.memory = 1024
          vb.cpus = 1
        end
  
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update
          apt-get install -y sudo openssh-server git
  
          # Crear usuario dadmin se non existe
          if ! id dadmin >/dev/null 2>&1; then
            useradd -m -s /bin/bash dadmin
            echo "dadmin:abc123." | chpasswd
          fi
  
          # Engadir a sudo
          usermod -aG sudo dadmin
  
          # Sudo sen contrasinal
          echo "dadmin ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dadmin
          chmod 440 /etc/sudoers.d/dadmin

          # Permitir que se poida conectar mediante contrasinal
          sed -i 's/^#PasswordAuthentication no/PasswordAuthentication yes/; s/^PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config
  
          # Activar SSH
          systemctl enable ssh
          systemctl restart ssh
        SHELL
      end
    end
  end